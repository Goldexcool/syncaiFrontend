# Backend API the browser calls (include /api). Production: https://api.usevoii.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Same API, used by Next.js for the /api/* proxy (server side).
VOII_API_PROXY_TARGET=http://localhost:8000/api
# Public site address: canonical links, sitemap, share previews. Production: https://usevoii.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
